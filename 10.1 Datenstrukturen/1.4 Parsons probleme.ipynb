     "text": [
      "Der Durchschnitt der ungeraden Zahlen zwischen 10 bis 20 ist 15.0\n"
     ]
    }
   ],
   "source": [
    "summe = 0\n",
    "anzahl = 0\n",
    "for zahl in range(10, 20):\n",
    "    if zahl % 2 == 0:\n",
    "continue\n",
    "anzahl += 1\n",
    "summe += zahl\n",
    "durchschnitt = summe / anzahl\n",
    "print(\"Der Durchschnitt der ungeraden Zahlen zwischen 10 bis 20 ist\", durchschnitt)\n",
    " "
   ]
  }
 ],
